<?xml version="1.0" encoding="utf-8"?>
<!--
  RimDelegation —— RimWorld 1.6 世界地图「委派」框架（经典 csproj，无 NuGet 还原）

  命令行覆盖路径示例：
    msbuild Source\RimDelegation.csproj /t:Build /p:RimWorldDir="D:\SteamLibrary\steamapps\common\RimWorld"
-->
<Project ToolsVersion="Current" DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">

  <!-- ===== 引用路径（本机实测路径，可用 /p: 覆盖） ===== -->
  <PropertyGroup>
    <RimWorldDir Condition="'$(RimWorldDir)' == ''">C:\Program Files (x86)\Steam\steamapps\common\RimWorld</RimWorldDir>
    <ManagedDir>$(RimWorldDir)\RimWorldWin64_Data\Managed</ManagedDir>
    <!-- 1.6 的游戏目录里【没有】0Harmony.dll，Harmony 由 brrainz.harmony 这个 Mod 提供 -->
    <HarmonyDir Condition="'$(HarmonyDir)' == ''">C:\Program Files (x86)\Steam\steamapps\workshop\content\294100\2009463077\Current\Assemblies</HarmonyDir>
    <!-- RIM-3（2026-10-05）：Radius UI Framework（workshop id 3786107692）——
         主控台皮肤已并入本体（Source\Skin\），所以它从"皮肤的依赖"变成**本体的硬依赖**。 -->
    <RadiusUIDir Condition="'$(RadiusUIDir)' == ''">C:\Program Files (x86)\Steam\steamapps\workshop\content\294100\3786107692\Assemblies</RadiusUIDir>
  </PropertyGroup>

  <!-- ===== 工程属性 ===== -->
  <PropertyGroup>
    <ProjectGuid>{3B7D4E52-91C6-4A0E-8F2D-6C1A9E4B7D33}</ProjectGuid>
    <ProjectTypeGuids>{FAE04EC0-301F-11D3-BF4B-00C04F79EFBC}</ProjectTypeGuids>
    <OutputType>Library</OutputType>
    <RootNamespace>RimDelegation</RootNamespace>
    <AssemblyName>RimDelegation</AssemblyName>
    <TargetFrameworkVersion>v4.7.2</TargetFrameworkVersion>
    <LangVersion>latest</LangVersion>
    <!-- 源码为 UTF-8（中文注释）：强制编译器按 UTF-8 读取 -->
    <CodePage>65001</CodePage>
    <FileAlignment>512</FileAlignment>
    <Deterministic>true</Deterministic>
    <WarningLevel>4</WarningLevel>
    <Configuration Condition="'$(Configuration)' == ''">Release</Configuration>
    <Platform Condition="'$(Platform)' == ''">AnyCPU</Platform>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Debug'">
    <DebugSymbols>true</DebugSymbols>
    <DebugType>portable</DebugType>
    <Optimize>false</Optimize>
    <DefineConstants>DEBUG;TRACE</DefineConstants>
    <OutputPath>$(MSBuildProjectDirectory)\..\Assemblies\</OutputPath>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <DebugSymbols>true</DebugSymbols>
    <DebugType>portable</DebugType>
    <Optimize>true</Optimize>
    <DefineConstants>TRACE</DefineConstants>
    <OutputPath>$(MSBuildProjectDirectory)\..\Assemblies\</OutputPath>
  </PropertyGroup>

  <!-- ===== .NET Framework 基础引用 ===== -->
  <ItemGroup>
    <Reference Include="System" />
    <Reference Include="System.Core" />
    <Reference Include="System.Xml" />
  </ItemGroup>

  <!-- ===== 游戏 / Harmony 引用 =====
       <Private>False</Private>：绝不把游戏或 Harmony 的 DLL 复制到模组输出目录，
       否则会与游戏已加载的程序集冲突。 -->
  <ItemGroup>
    <Reference Include="Assembly-CSharp">
      <HintPath>$(ManagedDir)\Assembly-CSharp.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(ManagedDir)\UnityEngine.CoreModule.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="UnityEngine.IMGUIModule">
      <HintPath>$(ManagedDir)\UnityEngine.IMGUIModule.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="UnityEngine.UIModule">
      <HintPath>$(ManagedDir)\UnityEngine.UIModule.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="UnityEngine.TextRenderingModule">
      <HintPath>$(ManagedDir)\UnityEngine.TextRenderingModule.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="UnityEngine.InputLegacyModule">
      <HintPath>$(ManagedDir)\UnityEngine.InputLegacyModule.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>$(HarmonyDir)\0Harmony.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <!-- RIM-3：主控台皮肤（Source\Skin\）在编译期强引用 Radius UI Framework。
         <Private>False</Private>：绝不把框架 dll 复制进 Assemblies\ ——
         那会让游戏重复加载同名程序集，直接冲突。 -->
    <Reference Include="RadiusUI.Framework">
      <HintPath>$(RadiusUIDir)\RadiusUI.Framework.dll</HintPath>
      <Private>False</Private>
    </Reference>
  </ItemGroup>

  <!-- ===== 源码 ===== -->
  <ItemGroup>
    <Compile Include="**\*.cs" Exclude="obj\**\*.cs;bin\**\*.cs" />
  </ItemGroup>

  <Import Project="$(MSBuildToolsPath)\Microsoft.CSharp.targets" />
</Project>
