<?xml version="1.0" encoding="utf-8"?>
<!--
  RimDelegation - Radius UI —— 试验性皮肤 mod（经典 csproj，无 NuGet 还原）

  命令行覆盖路径示例：
    msbuild Source\RimDelegation.RadiusUI.csproj /t:Build /p:RadiusUIDir="D:\refs\RadiusUI"
-->
<Project ToolsVersion="Current" DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">

  <!-- ===== 引用路径（本机实测路径，可用 /p: 覆盖） ===== -->
  <PropertyGroup>
    <RimWorldDir Condition="'$(RimWorldDir)' == ''">C:\Program Files (x86)\Steam\steamapps\common\RimWorld</RimWorldDir>
    <ManagedDir>$(RimWorldDir)\RimWorldWin64_Data\Managed</ManagedDir>
    <!-- 1.6 的游戏目录里【没有】0Harmony.dll，Harmony 由 brrainz.harmony 这个 Mod 提供 -->
    <HarmonyDir Condition="'$(HarmonyDir)' == ''">C:\Program Files (x86)\Steam\steamapps\workshop\content\294100\2009463077\Current\Assemblies</HarmonyDir>
    <!-- Radius UI Framework：workshop id 3786107692 -->
    <RadiusUIDir Condition="'$(RadiusUIDir)' == ''">C:\Program Files (x86)\Steam\steamapps\workshop\content\294100\3786107692\Assemblies</RadiusUIDir>
    <!-- RimDelegation：本机同级的兄弟模组目录 -->
    <RimDelegationDir Condition="'$(RimDelegationDir)' == ''">$(MSBuildProjectDirectory)\..\..\RimDelegation\Assemblies</RimDelegationDir>
  </PropertyGroup>

  <!-- ===== 工程属性 ===== -->
  <PropertyGroup>
    <ProjectGuid>{7C2E1A64-3F58-4B0D-9A21-5E8D3C7B6F40}</ProjectGuid>
    <ProjectTypeGuids>{FAE04EC0-301F-11D3-BF4B-00C04F79EFBC}</ProjectTypeGuids>
    <OutputType>Library</OutputType>
    <RootNamespace>RimDelegationRadiusUI</RootNamespace>
    <AssemblyName>RimDelegation.RadiusUI</AssemblyName>
    <TargetFrameworkVersion>v4.7.2</TargetFrameworkVersion>
    <LangVersion>latest</LangVersion>
    <!-- 源码为 UTF-8（中文注释）：强制编译器按 UTF-8 读取 -->
    <CodePage>65001</CodePage>
    <FileAlignment>512</FileAlignment>
    <Deterministic>true</Deterministic>
    <WarningLevel>4</WarningLevel>
    <Configuration Condition="'$(Configuration)' == ''">Release</Configuration>
    <Platform Condition="'$(Platform)' == ''">AnyCPU</Platform>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Debug'">
    <DebugSymbols>true</DebugSymbols>
    <DebugType>portable</DebugType>
    <Optimize>false</Optimize>
    <DefineConstants>DEBUG;TRACE</DefineConstants>
    <OutputPath>$(MSBuildProjectDirectory)\..\Assemblies\</OutputPath>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <DebugSymbols>true</DebugSymbols>
    <DebugType>portable</DebugType>
    <Optimize>true</Optimize>
    <DefineConstants>TRACE</DefineConstants>
    <OutputPath>$(MSBuildProjectDirectory)\..\Assemblies\</OutputPath>
  </PropertyGroup>

  <!-- ===== .NET Framework 基础引用 ===== -->
  <ItemGroup>
    <Reference Include="System" />
    <Reference Include="System.Core" />
    <Reference Include="System.Xml" />
  </ItemGroup>

  <!-- ===== 游戏 / Harmony / 框架 / RimDelegation 引用 =====
       <Private>False</Private>：绝不把这些 DLL 复制到本模组的输出目录。
       尤其是 RadiusUI.Framework.dll 与 RimDelegation.dll —— 复制进 Assemblies\ 会让游戏
       重复加载同名程序集，直接冲突。 -->
  <ItemGroup>
    <Reference Include="Assembly-CSharp">
      <HintPath>$(ManagedDir)\Assembly-CSharp.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(ManagedDir)\UnityEngine.CoreModule.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="UnityEngine.IMGUIModule">
      <HintPath>$(ManagedDir)\UnityEngine.IMGUIModule.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="UnityEngine.TextRenderingModule">
      <HintPath>$(ManagedDir)\UnityEngine.TextRenderingModule.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="UnityEngine.InputLegacyModule">
      <HintPath>$(ManagedDir)\UnityEngine.InputLegacyModule.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>$(HarmonyDir)\0Harmony.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="RadiusUI.Framework">
      <HintPath>$(RadiusUIDir)\RadiusUI.Framework.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="RimDelegation">
      <HintPath>$(RimDelegationDir)\RimDelegation.dll</HintPath>
      <Private>False</Private>
    </Reference>
  </ItemGroup>

  <!-- ===== 源码 ===== -->
  <ItemGroup>
    <Compile Include="**\*.cs" Exclude="obj\**\*.cs;bin\**\*.cs" />
  </ItemGroup>

  <Import Project="$(MSBuildToolsPath)\Microsoft.CSharp.targets" />
</Project>
